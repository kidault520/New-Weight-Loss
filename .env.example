# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# 浏览器读 user_profiles / user_preferences 等 PostgREST 的超时（毫秒）；弱网/VPN 建议 60000
VITE_SUPABASE_CLIENT_TIMEOUT_MS=60000
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Test Mode (set to 'true' for development, 'false' for production)
VITE_TEST_MODE=false
# 前端构建用：与 Node 不同域名时二选一
# （A）浏览器直连后端：VITE_API_URL=https://api.example.com/api
# （B）前端在 Vercel 且用同域 /api 代理：不配 VITE_API_URL，在 Vercel 设 API_PROXY_ORIGIN（见下方说明）
# VITE_API_URL=https://your-api-host.example.com/api

# 生产环境 Node：前端域名（多个英文逗号分隔），与 CORS 放行一致
# CORS_ORIGINS=https://your-app.vercel.app

# —— 仅 Vercel「前端 + 外链 Node」模式：把 /api 转发到独立 Node（本仓库已支持把 Express 打进 Vercel Serverless，多数情况无需此项）
# API_PROXY_ORIGIN=https://your-node.up.railway.app

# 固定验证码登录（无短信时）：与 allowSimulatedSms 同时为真时默认可用；或显式开启
# ALLOW_FIXED_OTP_LOGIN=true
# FIXED_OTP_CODE=111111

# 高德地图（收货地址「地图选点」Web 端 JS API Key；控制台绑定访问域名）
# https://console.amap.com/
VITE_AMAP_KEY=
# 可选：JS API 安全密钥（与 Key 配套，缓解 Key 盗用）
# VITE_AMAP_SECURITY_JS_CODE=

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# DeepSeek API (Primary AI provider)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# OpenAI API (Optional fallback)
OPENAI_API_KEY=your_openai_api_key

# Server Configuration
PORT=3001
NODE_ENV=development
APP_RUNTIME_MODE=dev_simulation
ALLOW_SIMULATED_PAYMENT=true
ALLOW_SIMULATED_DELIVERY=true
ALLOW_SIMULATED_SMS=true

# SMS / Payment / Delivery providers
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
DELIVERY_PROVIDER=mock

# Other AI Model APIs (optional)
CLAUDE_API_KEY=your_claude_api_key
GEMINI_API_KEY=your_gemini_api_key