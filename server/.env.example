# Runtime mode
NODE_ENV=development
APP_RUNTIME_MODE=dev_simulation

# Simulated switches
ALLOW_SIMULATED_PAYMENT=true
ALLOW_SIMULATED_DELIVERY=true
ALLOW_SIMULATED_SMS=true

# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# SMS (webhook / aggregator)
SMS_PROVIDER=mock
# SMS_WEBHOOK_URL=https://your-sms-aggregator.example.com/create
# SMS_WEBHOOK_TOKEN=your_sms_webhook_token

# Payment (webhook / aggregator)
PAYMENT_PROVIDER=mock
# PAYMENT_CREATE_WEBHOOK_URL=https://your-payment-aggregator.example.com/create
# PAYMENT_WEBHOOK_TOKEN=your_payment_webhook_token
# PAYMENT_CALLBACK_TOKEN=your_payment_callback_token

# Delivery (webhook / aggregator)
DELIVERY_PROVIDER=mock
# DELIVERY_CREATE_WEBHOOK_URL=https://your-delivery-aggregator.example.com/create
# DELIVERY_WEBHOOK_TOKEN=your_delivery_webhook_token
# DELIVERY_CALLBACK_TOKEN=your_delivery_callback_token

# DeepSeek API (Primary AI provider)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# OpenAI API (Optional fallback)
OPENAI_API_KEY=your_openai_api_key

# Server Configuration
PORT=3001

# Other AI Model APIs (optional)
CLAUDE_API_KEY=your_claude_api_key
GEMINI_API_KEY=your_gemini_api_key