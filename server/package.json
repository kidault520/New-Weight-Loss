{
  "name": "health-app-backend",
  "version": "1.0.0",
  "description": "Backend for Health Tracking App",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test tests/*.test.js",
    "preflight": "node ../scripts/preflight-readiness.cjs",
    "predeploy:check": "cd .. && node scripts/preflight-readiness.cjs --strict --env-file=server/.env.production.template",
    "predeploy:check:current-env": "cd .. && node scripts/preflight-readiness.cjs --strict",
    "predeploy:check:template": "cd .. && node scripts/preflight-readiness.cjs --strict --env-file=server/.env.production.template",
    "reconcile:delivery": "node scripts/reconcile-delivery-status.js",
    "reconcile:delivery:apply": "node scripts/reconcile-delivery-status.js --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "redis": "^5.11.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "health",
    "api",
    "backend",
    "supabase"
  ],
  "author": "Your Name",
  "license": "MIT"
}
