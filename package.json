{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cd server && node index.js",
    "server:dev": "cd server && nodemon index.js",
    "check:supabase-env": "node scripts/check-supabase-env-alignment.cjs",
    "sync:supabase-env-to-server": "node scripts/sync-supabase-env-to-server.cjs",
    "preflight": "node scripts/preflight-readiness.cjs",
    "preflight:json": "node scripts/preflight-readiness.cjs --json",
    "predeploy:check": "node scripts/preflight-readiness.cjs --strict --env-file=server/.env.production.template",
    "predeploy:check:current-env": "node scripts/preflight-readiness.cjs --strict",
    "predeploy:check:template": "node scripts/preflight-readiness.cjs --strict --env-file=server/.env.production.template",
    "server:install": "npm install express cors helmet morgan dotenv @supabase/supabase-js axios bcryptjs jsonwebtoken express-rate-limit express-validator winston --save",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@supabase/supabase-js": "^2.84.0",
    "@tanstack/query-persist-client-core": "^5.0.0",
    "@tanstack/react-query": "^5.90.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.2",
    "baseline-browser-mapping": "^2.9.4",
    "bcryptjs": "^3.0.3",
    "caniuse-lite": "^1.0.30001759",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "openai": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.10.3",
    "redis": "^5.11.0",
    "serverless-http": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/dom-speech-recognition": "^0.0.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^23.2.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.0.15"
  }
}
